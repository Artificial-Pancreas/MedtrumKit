          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când atingeți butonul, veți primi o solicitare biometrică. Odată finalizat, plasturele va fi dezactivat și vi se va solicita să asociați un nou plasture transdermic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При нажатии кнопки появится запрос на биометрию. После подтверждения патч деактивируется, и вам предложат подключить новый."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknutí na tlačidlo sa zobrazí výzva na biometrickú identifikáciu. Po jej dokončení sa náplasť deaktivuje a zobrazí sa výzva na spárovanie novej náplasti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du klickar på knappen får du en biometriprompt. När den är klar, kommer patchen att inaktiveras och du kommer att uppmanas att parkoppla en ny patch-pump."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після натискання кнопки ви отримаєте запит на біометричні дані. Після завершення Патч буде деактивовано, і вам буде запропоновано підключити новий Патч."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nhấn vào nút, bạn sẽ được yêu cầu xác thực sinh trắc học. Sau khi hoàn tất, Patch sẽ được hủy kích hoạt và bạn sẽ được nhắc ghép nối một Patch mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        }
      }
    },
