    "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch." : {
      "comment" : "Instructions for deactivate patch",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند النقر على الزر، سيظهر لك مُوجّه القياسات الحيوية (Biometrics prompt). بمجرد الانتهاء، سيتم إلغاء تفعيل اللصقة وستُطالَب بإقران لصقة جديدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בלחיצה על הכפתור תקבל הנחיה ביומטריה. לאחר השלמתו, התיקון יבוטל ותתבקש להתאים תיקון חדש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gombra kattintva megjelenik a biometrikus adatokra vonatkozó kérés. Ha befejezte, a tapasz deaktiválódik, és felszólítást kap egy új tapasz párosítására."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버튼을 클릭하면 생체 인식 프롬프트가 표시됩니다. 완료되면 패치가 비활성화되고 새 패치를 페어링하라는 메시지가 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du klikker på knappen, vil du få en biometrisk ledetekst. Når depotplasteret er ferdig, vil det bli deaktivert og du vil bli bedt om å pare et nytt depotplaster"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je op de knop klikt, krijg je een Biometrie prompt. Zodra klaar wordt de patch gedeactiveerd en wordt je gevraagd om een nieuwe patch te koppelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicking on the button, you will get a Biometrics prompt. Once completed, the patch will be deactivated and you will be prompted to pair a new patch."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când atingeți butonul, veți primi o solicitare biometrică. Odată finalizat, plasturele va fi dezactivat și vi se va solicita să asociați un nou plasture."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При нажатии кнопки появится запрос на биометрию. После подтверждения патч деактивируется, и вам предложат подключить новый."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknutí na tlačidlo sa zobrazí výzva na biometrickú identifikáciu. Po jej dokončení sa náplasť deaktivuje a zobrazí sa výzva na spárovanie novej náplasti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du klickar på knappen får du en biometriprompt. När den är klar, kommer patchen att inaktiveras och du kommer att uppmanas att parkoppla en ny patch-pump."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
