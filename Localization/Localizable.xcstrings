          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Currently, you are using a heartbeat mode. This is needed to keep %1$@ running in the background. This might be interesting if your CGM already provides a heartbeat. It is recommended to keep this feature enabled"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Currently, you are using a heartbeat mode. This is needed to keep %1$@ running in the background. This might be interesting if your CGM already provides a heartbeat. It is recommended to keep this feature enabled"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Currently, you are using a heartbeat mode. This is needed to keep %1$@ running in the background. This might be interesting if your CGM already provides a heartbeat. It is recommended to keep this feature enabled"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы используете режим heartbeat, необходимый для работы %1$@ в фоновом режиме. Это может быть полезно, если ваш CGM уже предоставляет heartbeat. Рекомендуется оставить эту функцию включённой"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V súčasnosti používate režim heartbeat. Je to potrebné na to, aby %1$@ bežal na pozadí. To môže byť zaujímavé, ak Váš CGM už poskytuje heartbeat. Odporúča sa nechať túto funkciu zapnutú"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För närvarande använder du ett hjärtslagsläge. Detta behövs för att hålla %1$@ igång i bakgrunden. Detta kan vara lämpligt om din CGM redan ger ett hjärtslag. Det rekommenderas att hålla denna funktion aktiverad"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Currently, you are using a heartbeat mode. This is needed to keep %1$@ running in the background. This might be interesting if your CGM already provides a heartbeat. It is recommended to keep this feature enabled"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наразі ви використовуєте режим серцебиття. Це необхідно для того, щоб %1$@ працював у фоновому режимі. Це може бути цікаво, якщо ваш CGM вже забезпечує серцебиття. Рекомендується залишити цю функцію ввімкненою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện tại, bạn đang sử dụng chế độ nhịp tim (heartbeat mode). Chế độ này cần thiết để giữ cho %1$@ tiếp tục chạy trong nền. Điều này có thể hữu ích nếu CGM của bạn đã cung cấp nhịp tim. Khuyến nghị bạn nên giữ tính năng này được bật"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Currently, you are using a heartbeat mode. This is needed to keep %1$@ running in the background. This might be interesting if your CGM already provides a heartbeat. It is recommended to keep this feature enabled"
          }
        }
      }
    },
