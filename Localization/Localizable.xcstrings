    "%@ will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يقوم %@ بضبط كمية الأنسولين المُقدَّمة تلقائيًّا حتى تنتهي فترة المعدل الأساسي المؤقت أو يتم إلغاؤه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ automaticky neupraví dávkování inzulínu, dokud dočasná bazální dávka neskončí nebo nebude zrušena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vil ikke automatisk justere din insulintilførsel, før den midlertidige basale dosis er afsluttet eller annulleret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passt Ihre Insulinabgabe erst dann automatisch an, wenn die temporäre Basalrate abgelaufen ist oder abgebrochen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ajustará automáticamente la administración de insulina hasta que finalice o se cancele la tasa basal temporal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ei säädä insuliinin annostelua automaattisesti, ennen kuin väliaikainen perusannos päättyy tai se peruutetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'ajustera pas automatiquement votre débit d'insuline tant que le débit basal temporaire n'aura pas pris fin ou n'aura pas été annulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ לא יתאים אוטומטית את אספקת האינסולין שלך עד ששיעור הבסיס הזמני יסתיים או יבוטל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ nem állítja be automatikusan az inzulinadagolást mindaddig, amíg az ideiglenes bazális adagolás le nem jár, vagy meg nem szüntetik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non regolerà automaticamente il rilascio di insulina finché il tasso basale temporaneo non sarà terminato o non verrà annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、一時的な基礎インスリン投与が終了するか、キャンセルされるまで、インスリンの投与量を自動的に調整することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@는 일시적 기저 인슐린 투여가 종료되거나 취소될 때까지 인슐린 투여량을 자동으로 조정하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vil ikke automatisk justere insulintilførselen før den midlertidige basale hastigheten er fullført eller avbrutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ past de insulineafgifte niet automatisch aan totdat de tijdelijke basale dosis is afgelopen of is geannuleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie dostosuje automatycznie dawki insuliny, dopóki tymczasowa dawka podstawowa nie dobiegnie końca lub nie zostanie anulowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ não ajustará automaticamente a administração de insulina até que a taxa basal temporária termine ou seja cancelada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nu va regla automat administrarea de insulină până când rata bazală temporară nu se încheie sau nu este anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не будет автоматически регулировать подачу инсулина до тех пор, пока временная базальная скорость не закончится или не будет отменена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ automaticky neupraví podávanie inzulínu, kým sa dočasná bazálna rýchlosť neskončí alebo nebude zrušená."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne bo samodejno prilagodil dovajanja insulina, dokler se začasna bazalna hitrost ne zaključi ali se prekliče."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kommer inte att justera din insulintillförsel automatiskt förrän den tillfälliga basaldosen har avslutats eller avbrutits."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, geçici bazal hız sona erene veya iptal edilene kadar insülin verimini otomatik olarak ayarlamayacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не буде автоматично коригувати подачу інсуліну, доки тимчасовий базовий рівень не закінчиться або не буде скасований."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ không tự động điều chỉnh việc cung cấp insulin của bạn cho đến khi tỷ lệ cơ bản tạm thời kết thúc hoặc bị hủy bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在临时基础率结束或被取消之前，%@ 不会自动调整您的胰岛素输注量。"
          }
        }
      }
    },
